{
  "name": "portal-hopper",
  "version": "1.0.0",
  "description": "Portal Hopper: hop through portals to spooky, spacey and frosty worlds",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "_build": "tsc && vite build",
    "build": "npm run _build",
    "build:bundled": "cross-env RUNDOT_GAME_DISABLE_EMBEDDED_LIBS=true npm run _build",
    "preview": "vite preview",
    "deploy": "npm run build && rundot deploy",
    "build:pwa": "tsc && vite build --mode pwa",
    "dev:pwa": "vite --mode pwa",
    "release": "node ../f12-games/tools/release.mjs"
  },
  "keywords": [
    "phaser",
    "vite",
    "typescript",
    "game"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.txt",
  "devDependencies": {
    "@babel/parser": "^7.26.3",
    "@types/node": "^24.3.0",
    "cross-env": "^7.0.3",
    "firebase": "^12.12.1",
    "magic-string": "^0.30.11",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@series-inc/rundot-game-sdk": "^5.39.0",
    "phaser": "3.90.0"
  }
}
