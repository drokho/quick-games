# F12 Games FTP login. Copy this file to .env.deploy and fill it in.
# .env.deploy stays on this computer: it is never uploaded or shared.
FTP_HOST=ftp.f12crowd.com
FTP_USER=
FTP_PASS=
# true = FTPS (encrypted, recommended), implicit = FTPS on port 990, false = plain FTP
FTP_SECURE=true
FTP_PORT=21
# Only if the FTP certificate is issued to another name than FTP_HOST (Hostinger: hstgr.io)
FTP_TLS_NAME=
# The folder on the server that games.f12crowd.com serves, e.g. /public_html/games or /games.f12crowd.com
FTP_ROOT=/games.f12crowd.com
